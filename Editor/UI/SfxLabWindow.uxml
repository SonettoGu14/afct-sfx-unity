<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns="UnityEngine.UIElements">
    <ui:VisualElement>
        <ui:VisualElement class="sfxlab">
            <ui:VisualElement class="top">
                <ui:VisualElement class="top__title">
                    <ui:Label text="AFCT SFX Lab" class="top__heading" />
                    <ui:Label text="A production sheet for game sound effects." class="top__subtitle" />
                </ui:VisualElement>
                <ui:VisualElement class="top__meta">
                    <ui:VisualElement class="meta-row">
                        <ui:Label text="Sample rate" class="meta-row__label" />
                        <ui:VisualElement name="sample-rate-slot" class="select-slot" />
                    </ui:VisualElement>
                    <ui:VisualElement class="meta-row">
                        <ui:Label text="Export folder" class="meta-row__label" />
                        <ui:Label name="export-folder" text="Assets/Audio/SFX/ui/" class="meta-row__value mono" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="workspace">
                <ui:ScrollView name="rail-scroll" class="rail-scroll">
                    <ui:VisualElement name="rail" class="rail" />
                </ui:ScrollView>

                <ui:VisualElement class="sheet-column">
                    <ui:ScrollView name="param-scroll" class="param-scroll">
                        <ui:VisualElement class="preset-head">
                            <ui:Label name="preset-name" text="Click" class="preset-name" />
                            <ui:Label name="preset-line" text="UI preset, Sfxr engine, square wave." class="preset-line" />
                        </ui:VisualElement>

                        <ui:VisualElement name="param-groups" class="param-groups" />

                        <ui:VisualElement class="master">
                            <ui:VisualElement class="master__head">
                                <ui:Label text="Export" class="master__title" />
                                <ui:Label text="Writes into the project." class="master__note" />
                            </ui:VisualElement>
                            <ui:VisualElement class="master-row">
                                <ui:Label text="File name" class="master-row__label" />
                                <ui:TextField name="file-name" class="field" />
                            </ui:VisualElement>
                            <ui:VisualElement class="master-row">
                                <ui:Label text="Trim silence" class="master-row__label" />
                                <ui:VisualElement name="trim-slot" class="slot" />
                            </ui:VisualElement>
                            <ui:VisualElement class="master-row">
                                <ui:Label text="Peak target" class="master-row__label" />
                                <ui:VisualElement name="peak-slot" class="slot" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:ScrollView>
                </ui:VisualElement>

                <ui:VisualElement name="monitor" class="monitor">
                    <ui:VisualElement class="monitor__head">
                        <ui:Label text="Monitor" class="monitor__title" />
                        <ui:Label name="monitor-meta" text="44.1 kHz, 16 bit" class="monitor__meta mono" />
                    </ui:VisualElement>

                    <ui:VisualElement name="waveform-slot" class="waveform-slot" />

                    <ui:VisualElement class="readouts">
                        <ui:VisualElement class="readouts__row">
                            <ui:VisualElement class="readout">
                                <ui:Label text="Duration" class="readout__label" />
                                <ui:Label name="readout-duration" text="0.00 s" class="readout__value mono" />
                            </ui:VisualElement>
                            <ui:VisualElement class="readout">
                                <ui:Label text="Samples" class="readout__label" />
                                <ui:Label name="readout-samples" text="0" class="readout__value mono" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="readouts__row">
                            <ui:VisualElement class="readout">
                                <ui:Label text="Peak" class="readout__label" />
                                <ui:Label name="readout-peak" text="0.00" class="readout__value mono" />
                            </ui:VisualElement>
                            <ui:VisualElement class="readout">
                                <ui:Label text="Clipped" class="readout__label" />
                                <ui:Label name="readout-clipped" text="0" class="readout__value mono" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement class="transport">
                        <ui:Button name="play-button" text="Play" class="transport__button transport__button--play" />
                        <ui:Button name="stop-button" text="Stop" class="transport__button" />
                        <ui:Button name="export-button" text="Export" class="transport__button transport__button--export" />
                    </ui:VisualElement>

                    <ui:Label name="status" text="Ready." class="status" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
